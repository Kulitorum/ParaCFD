+            for(int vertex=0;vertex<8;++vertex)
+            {
+                Vec3d p;placement.apply((vertex&1)?half.x:-half.x,
+                    (vertex&2)?half.y:-half.y,(vertex&4)?half.z:-half.z,p.x,p.y,p.z);
+                for(int axis=0;axis<3;++axis)
